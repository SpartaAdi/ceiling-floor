# Copy to .env.local (git-ignored) for local testing, and add the same three
# variables in Vercel → Project → Settings → Environment Variables.
# All three are PUBLIC values by design (access is enforced by row-level security).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
